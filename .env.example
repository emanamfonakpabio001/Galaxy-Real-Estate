# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MongoDB Database Configuration
# Provide your MongoDB Atlas connection string or leave blank for embedded mode
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/galaxy_real_estate?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DATABASE="galaxy_real_estate"

# Security & Session Authentication Secrets (Provide random strings in production)
SESSION_SECRET=""
JWT_SECRET=""

# Client and Server URLs
CLIENT_URL=""
SERVER_URL=""

# Initial Admin Credentials (used to seed admin user on initial setup)
ADMIN_EMAIL="admin@galaxyrealestate.com"
ADMIN_INITIAL_PASSWORD=""
